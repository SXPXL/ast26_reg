# Application Settings
PROJECT_NAME="Athra Fest Portal API"
API_V1_STR="/api/v1"
DEBUG=True

# Authentication Toggle (Set to False to bypass JWT/Auth for fast testing/dev)
REQ_AUTH=True

# JWT Secret & Expiry
SECRET_KEY="replace_this_with_a_super_secret_jwt_key_fest_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/athra_fest_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/athra_fest_db"

# Payment Provider Gateway Selection (switch seamlessly without rewriting code)
# Options: "razorpay" (recommended) | "cashfree" | "manual_upi" | "manual" (pay at event desk)
PAYMENT_PROVIDER="razorpay"
# Optional override: setting PAYMENT_MODE="manual" disables all online payments (pay at desk)
# PAYMENT_MODE="manual"

# Razorpay Credentials (required when PAYMENT_PROVIDER=razorpay)
# Public Key ID (shared with frontend checkout modal)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
# Secret Key (kept STRICTLY server-side on backend)
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
# Webhook Secret (configured in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# Manual UPI Direct Transfer Settings (fallback when PAYMENT_PROVIDER=manual_upi)
MANUAL_UPI_ID="asthra26@upi"
MANUAL_UPI_NAME="Asthra 26 Mathematics Dept"
MANUAL_UPI_QR_IMAGE=""

# Cashfree Payment Gateway Credentials (optional legacy fallback)
CASHFREE_APP_ID="TEST_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="TEST_CASHFREE_SECRET_KEY"
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_ENVIRONMENT="SANDBOX" # SANDBOX or PRODUCTION
CASHFREE_RETURN_URL="http://localhost:5173/payment/status?order_id={order_id}"

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# User Help & Support Contacts (WhatsApp & Phone)
VITE_HELP_WHATSAPP_NUMBER="+919876543210"
VITE_HELP_PHONE_NUMBER="+919876543210"
