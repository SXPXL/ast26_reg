# Application Settings
PROJECT_NAME="Athra Fest Portal API"
API_V1_STR="/api/v1"
DEBUG=True

# Authentication Toggle (Set to False to bypass JWT/Auth for fast testing/dev)
REQ_AUTH=True

# JWT Secret & Expiry
SECRET_KEY="replace_this_with_a_super_secret_jwt_key_fest_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/athra_fest_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/athra_fest_db"

# Cashfree Payment Gateway Credentials
CASHFREE_APP_ID="TEST_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="TEST_CASHFREE_SECRET_KEY"
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_ENVIRONMENT="SANDBOX" # SANDBOX or PRODUCTION
CASHFREE_RETURN_URL="http://localhost:5173/payment/status?order_id={order_id}"

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
